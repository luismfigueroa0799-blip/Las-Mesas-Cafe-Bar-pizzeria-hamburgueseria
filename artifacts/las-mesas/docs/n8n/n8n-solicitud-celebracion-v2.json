        "jsCode": "// Normaliza la solicitud de celebracion: deja los datos con el nombre de\n// las columnas de la tabla solicitudes_celebracion, este donde estuvieran.\nconst salida = [];\nfor (const item of items) {\n  const j = item.json ?? {};\n  let b = j.body ?? j;\n  if (typeof b === 'string') {\n    try { b = JSON.parse(b); } catch { b = {}; }\n  }\n  const f = { ...j, ...b };\n  salida.push({\n    json: {\n      nombre: f.nombre ?? '',\n      contacto: f.contacto ?? '',\n      tipo_evento: f.tipoEvento ?? f.tipo_evento ?? '',\n      fecha_aproximada: f.fechaAproximada ?? f.fecha_aproximada ?? '',\n      numero_personas: Number(f.numeroPersonas ?? f.numero_personas ?? 0),\n      detalles: f.detalles ?? '',\n    },\n  });\n}\nreturn salida;"
      },
