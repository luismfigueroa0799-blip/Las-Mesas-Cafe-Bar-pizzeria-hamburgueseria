{
  "name": "Pedidos: crear pedido mesa (Neon)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crear-pedido-mesa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-mesa",
      "name": "Recibir pedido mesa",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [200, 300],
      "webhookId": "TU_WEBHOOK_ID_MESA"
    },
    {
      "parameters": {
        "jsCode": "// Validar mesa (1-8) y items\nconst mesa = Number($json.mesa);\nif (!Number.isInteger(mesa) || mesa < 1 || mesa > 8) {\n  return [{ json: { ok: false, error: 'Mesa inválida: elige una mesa del 1 al 8' } }];\n}\nif (!Array.isArray($json.items) || $json.items.length === 0) {\n  return [{ json: { ok: false, error: 'El carrito está vacío' } }];\n}\n\nconst agrupados = {};\nfor (const it of $json.items) {\n  const id = it && it.id;\n  const qty = Number(it && it.qty);\n  if (!id || String(id).trim() === '') return [{ json: { ok: false, error: 'Producto sin id' } }];\n  if (!Number.isInteger(qty) || qty < 1 || qty > 50) return [{ json: { ok: false, error: 'Cantidad inválida' } }];\n  const clave = String(id);\n  agrupados[clave] = (agrupados[clave] || 0) + qty;\n}\n\nreturn [{ json: { ...$json, mesa: String(mesa), tipo_entrega: 'mesa', items: Object.keys(agrupados).map(id => ({ id, qty: agrupados[id] })) } }];",
        "outputParameters": {}
      },
      "id": "validar-mesa",
      "name": "Validar mesa y carrito",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, price, disponible FROM products;",
        "options": {}
      },
      "id": "consultar-productos",
      "name": "Consultar productos (Neon)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [700, 300],
      "credentials": {
        "postgres": { "id": "TU_CREDENCIAL_NEON", "name": "Neon / Postgres" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Calcular total con precios de Neon y validar disponibilidad\nconst pedido = $json;\nconst productos = $('Consultar productos (Neon)').all().map(i => i.json).filter(p => p && p.id != null);\n\nlet totalCents = 0;\nconst lineas = [];\nfor (const it of pedido.items) {\n  const prod = productos.find(p => String(p.id) === String(it.id));\n  if (!prod) return [{ json: { ok: false, error: 'Producto no encontrado: ' + it.id } }];\n  if (prod.disponible !== true) return [{ json: { ok: false, error: 'Producto agotado: ' + (prod.name || prod.id) } }];\n  const precio = Number(prod.price);\n  if (!Number.isFinite(precio) || precio < 0) return [{ json: { ok: false, error: 'Precio inválido' } }];\n  const unit = Math.round(precio * 100);\n  const sub = unit * it.qty;\n  totalCents += sub;\n  lineas.push({ id: prod.id, nombre: prod.name, qty: it.qty, precio, subtotal: sub / 100 });\n}\n\nif (totalCents <= 0) return [{ json: { ok: false, error: 'Total inválido' } }];\n\nconst detalleTexto = lineas.map(l => (l.qty > 1 ? l.qty + ' x ' : '') + l.nombre + ' - ' + l.precio.toFixed(2).replace('.', ',') + ' €').join('\\n');\n\nreturn [{ json: {\n  ...pedido,\n  valido: true,\n  lineas,\n  total: totalCents / 100,\n  total_centimos: totalCents,\n  total_texto: (totalCents / 100).toFixed(2),\n  detalle_texto: detalleTexto,\n  estado: 'pendiente_pago'\n} }];",
        "outputParameters": {}
      },
      "id": "calcular-mesa",
      "name": "Calcular total (Neon)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [950, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [{ "id": "valido", "leftValue": "={{ $json.valido }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "valido-mesa",
      "name": "¿Pedido válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "table": { "__rl": true, "value": "pedidos", "mode": "list" },
        "columns": {
