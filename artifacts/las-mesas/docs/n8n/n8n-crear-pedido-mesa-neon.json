    {
      "parameters": {
        "jsCode": "const webhook = $('Recibir pedido mesa').first().json;\nconst pedido = webhook.body ?? webhook;\n\nconst rawItems = Array.isArray(pedido.items) ? pedido.items : [];\nconst productos = $('Consultar productos (Neon)').all().map(i => i.json).filter(p => p && p.id != null);\n\nlet totalCents = 0;\nconst lineas = [];\n\nrawItems.forEach(function(it) {\n  const id = String(it && (it.id ?? it.producto_id) ?? '').trim();\n  const qty = Number(it && (it.qty ?? it.quantity ?? it.cantidad));\n  const prod = productos.find(function(p) { return String(p.id).trim() === id; });\n  if (prod && qty > 0) {\n    const precio = Number(prod.price ?? prod.precio ?? 0);\n    const sub = Math.round(precio * 100) * qty;\n    totalCents += sub;\n    lineas.push({ id: prod.id, nombre: prod.name || prod.nombre || id, qty: qty, precio: precio, subtotal: sub / 100 });\n  }\n});\n\nif (lineas.length === 0 || totalCents <= 0) {\n  return [{ json: { valido: false, error: 'No hay items. Recibido: ' + JSON.stringify(pedido).slice(0, 300) } }];\n}\n\nconst detalleTexto = lineas.map(function(l) {\n  return (l.qty > 1 ? l.qty + ' x ' : '') + l.nombre + ' - ' + l.precio.toFixed(2).replace('.', ',') + ' €';\n}).join('\\n');\n\nreturn [{\n  json: {\n    valido: true,\n    mesa: String(pedido.mesa ?? ''),\n    tipo_entrega: 'mesa',\n    id_pedido: 'MES-' + String(pedido.mesa ?? '') + '-' + Date.now(),\n    customerName: pedido.customerName ?? '',\n    telefono: pedido.telefono ?? '',\n    direccion: pedido.direccion ?? '',\n    urlOrigen: pedido.urlOrigen ?? '',\n    lineas: lineas,\n    total: totalCents / 100,\n    total_centimos: totalCents,\n    total_texto: (totalCents / 100).toFixed(2),\n    detalle_texto: detalleTexto,\n    estado: 'pendiente_pago'\n  }\n}];"
      },
