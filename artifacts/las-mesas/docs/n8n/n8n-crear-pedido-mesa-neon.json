            { "name": "success_url", "value": "={{ $json.url_origen }}?pedido=ok&session_id={CHECKOUT_SESSION_ID}" },
            { "name": "cancel_url", "value": "={{ $json.url_origen }}?pedido=cancelado" }
          ]
        },
        "options": {}
      },
