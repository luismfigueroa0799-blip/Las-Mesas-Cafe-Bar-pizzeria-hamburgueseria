        },
        "options": {}
      },
      "id": "insertar-pedido-mesa",
      "name": "Insertar pedido (Neon)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [1450, 150],
      "credentials": { "postgres": { "id": "TU_CREDENCIAL_NEON", "name": "Neon / Postgres" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/checkout/sessions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "stripeApi",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
