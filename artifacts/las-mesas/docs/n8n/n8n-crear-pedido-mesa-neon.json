            { "name": "line_items[0][price_data][product_data][name]", "value": "=Pedido Mesa {{ $json.mesa }} #{{ $json.id_pedido }}" },
            { "name": "line_items[0][price_data][unit_amount]", "value": "={{ $json.total_centimos }}" },
            { "name": "line_items[0][quantity]", "value": "1" },
            { "name": "metadata[pedido_id]", "value": "={{ $json.id_pedido }}" },
            { "name": "metadata[mesa]", "value": "={{ $json.mesa }}" },
            { "name": "metadata[tipo_entrega]", "value": "mesa" },
