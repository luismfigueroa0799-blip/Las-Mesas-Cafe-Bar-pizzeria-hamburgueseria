    {
      "parameters": {
        "jsCode": "// n8n a veces envuelve el body en $json.body y otras veces lo deja en $json directamente\nconst raw = $json.body ?? $json;\n\n// Validar mesa\nconst mesa = Number(raw.mesa ?? '');\nif (!Number.isInteger(mesa) || mesa < 1 || mesa > 8) {\n  return [{ json: { ok: false, error: 'Mesa inválida' } } ];\n}\n\n// Buscar items en cualquier propiedad posible\nlet itemsRaw = [];\nif (Array.isArray(raw.items)) itemsRaw = raw.items;\nelse if (Array.isArray(raw.carrito)) itemsRaw = raw.carrito;\nelse if (Array.isArray(raw.lineas)) itemsRaw = raw.lineas;\n\nif (!itemsRaw || itemsRaw.length === 0) {\n  return [{ json: { ok: false, error: 'No hay items en el carrito' } } ];\n}\n\n// El frontend envia \"quantity\", otros flujos usan \"qty\" o \"cantidad\"\nconst agrupados = {};\nfor (const it of itemsRaw) {\n  const id = String(it && (it.id ?? it.producto_id) ?? '').trim();\n  const qty = Number(it && (it.qty ?? it.quantity ?? it.cantidad));\n  if (!id) return [{ json: { ok: false, error: 'Producto sin id' } } ];\n  if (!Number.isInteger(qty) || qty < 1 || qty > 50) return [{ json: { ok: false, error: 'Cantidad inválida' } } ];\n  agrupados[id] = (agrupados[id] || 0) + qty;\n}\n\nconst items = Object.keys(agrupados).map(id => ({ id, qty: agrupados[id] }));\n\nreturn [{\n  json: {\n    mesa: String(mesa),\n    tipo_entrega: 'mesa',\n    items: items,\n    id_pedido: 'MES-' + String(mesa) + '-' + Date.now(),\n    customerName: raw.customerName ?? raw.nombre ?? '',\n    customerEmail: raw.customerEmail ?? raw.email ?? '',\n    telefono: raw.telefono ?? '',\n    direccion: raw.direccion ?? '',\n    total: raw.total ?? '0',\n    urlOrigen: raw.urlOrigen ?? ''\n  }\n}];"
      },
