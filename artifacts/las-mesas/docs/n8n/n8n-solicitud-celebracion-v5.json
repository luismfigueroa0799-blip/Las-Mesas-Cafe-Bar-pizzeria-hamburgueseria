      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normaliza los datos y conserva la referencia y el estado inicial.\nconst salida = [];\nfor (const item of items) {\n  const j = item.json ?? {};\n  let b = j.body ?? j;\n  if (typeof b === 'string') { try { b = JSON.parse(b); } catch { b = {}; } }\n  const f = { ...j, ...b };\n  const nombre = String(f.nombre ?? '');\n  const contacto = String(f.contacto ?? '');\n  const tipo = String(f.tipoEvento ?? f.tipo_evento ?? '');\n  const fecha = String(f.fechaAproximada ?? f.fecha_aproximada ?? '');\n  const personas = Number(f.numeroPersonas ?? f.numero_personas ?? 0);\n  const detalles = String(f.detalles ?? '');\n  const codigo = String(f.codigo ?? '');\n  salida.push({ json: {\n    nombre, contacto, tipo_evento: tipo, fecha_aproximada: fecha,\n    numero_personas: personas, detalles, codigo,\n    estado: 'nueva', recordatorio_enviado: false,\n    mensaje: '🎉 NUEVA SOLICITUD DE CELEBRACIÓN 🎉\\n\\n' +\n      'Referencia: ' + codigo + '\\n' +\n      '👤 ' + nombre + '\\n' + '📞 ' + contacto + '\\n' +\n      '🎊 ' + tipo + '\\n' + '📅 ' + fecha + '\\n' +\n      '👥 ' + personas + ' personas\\n\\n' + '📝 ' + detalles\n  } });\n}\nreturn salida;"
      },
