    {
      "parameters": {
        "jsCode": "// \"No confies en ningun precio del frontend\": el total se calcula solo con precios de la base de datos.\nconst pedido = $('Validar horario y datos de entrega').first().json;\nconst productos = $('Consultar productos').all().map(function (i) { return i.json; }).filter(function (p) { return p && p.id !== undefined && p.id !== null; });\n\nfunction rechazar(codigo, error) {\n  return [{ json: { valido: false, codigo: codigo, error: error } }];\n}\n\nlet totalCentimos = 0;\nconst items = [];\nfor (const it of pedido.items) {\n  const prod = productos.find(function (p) { return String(p.id) === String(it.id); });\n  if (!prod) return rechazar(400, 'El producto ' + it.id + ' no existe.');\n  // La tabla products de Neon usa price e is_available; los nombres antiguos\n  // se siguen admitiendo por si el flujo lee de Supabase.\n  const nombreProd = prod.name !== undefined ? prod.name : prod.nombre;\n  const disponible = prod.is_available !== undefined\n    ? prod.is_available !== false\n    : prod.disponible !== false;\n  if (!disponible) return rechazar(409, 'El producto ' + (nombreProd || it.id) + ' no esta disponible.');\n  const precio = Number(prod.price !== undefined ? prod.price : prod.precio);\n  if (!Number.isFinite(precio) || precio < 0) return rechazar(500, 'Precio no valido para el producto ' + it.id + '.');\n  const unitCent = Math.round(precio * 100);\n  const subCent = unitCent * it.qty;\n  totalCentimos += subCent;\n  items.push({\n    id: prod.id,\n    nombre: prod.name !== undefined ? prod.name : (prod.nombre !== undefined ? prod.nombre : null),\n    qty: it.qty,\n    precio_unitario: unitCent / 100,\n    subtotal: subCent / 100,\n  });\n}\n\nif (totalCentimos <= 0) return rechazar(400, 'El total del pedido no es valido.');\n\nconst total = totalCentimos / 100;\n\n// El detalle en el formato que usa el flujo de confirmacion de pago: el\n// precio como texto (\"6,50 EUR\") y los importes en centimos.\nconst lineasTexto = items.map(function (it) {\n  const precio = Number(it.precio_unitario).toFixed(2).replace('.', ',') + ' €';\n  return {\n    id: String(it.id),\n    nombre: it.nombre,\n    name: it.nombre,\n    cantidad: it.qty,\n    qty: it.qty,\n    precio: precio,\n    price: precio,\n    unit_cents: Math.round(Number(it.precio_unitario) * 100),\n    subtotal_cents: Math.round(Number(it.subtotal) * 100),\n  };\n});\n\nconst detalleTexto = items.map(function (it) {\n  const precio = Number(it.precio_unitario).toFixed(2).replace('.', ',') + ' €';\n  return (it.qty > 1 ? it.qty + ' x ' : '') + it.nombre + ' - ' + precio;\n}).join('\\n');\n\nconst resumen = [\n  'Cliente: ' + pedido.nombre,\n  'Telefono: ' + pedido.cliente_telefono,\n  'Direccion: ' + pedido.direccion,\n  'TOTAL: ' + total.toFixed(2).replace('.', ',') + ' EUR',\n].join('\\n');\n\nreturn [{\n  json: {\n    valido: true,\n    tipo: 'domicilio',\n    mesa_id: null,\n    direccion: pedido.direccion,\n    cliente_telefono: pedido.cliente_telefono,\n    nombre: pedido.nombre,\n    items: items,\n    total: total,\n    total_centimos: totalCentimos,\n    total_texto: total.toFixed(2),\n    items_texto: JSON.stringify(lineasTexto),\n    detalle_texto: detalleTexto,\n    resumen: resumen,\n    numArticulos: String(items.length),\n    estado: 'pendiente_pago',\n  },\n}];"
      },
