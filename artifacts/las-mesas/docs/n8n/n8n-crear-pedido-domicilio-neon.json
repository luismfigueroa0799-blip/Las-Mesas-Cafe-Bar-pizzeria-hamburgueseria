    {
      "parameters": {
        "jsCode": "// Horario de atencion (zona Atlantic/Canary). 1 = lunes ... 7 = domingo. null = cerrado.\nconst HORARIO = {\n  1: { abre: '08:00', cierra: '23:00' },\n  2: { abre: '08:00', cierra: '23:00' },\n  3: { abre: '08:00', cierra: '23:00' },\n  4: { abre: '08:00', cierra: '23:00' },\n  5: { abre: '08:00', cierra: '23:00' },\n  6: { abre: '08:00', cierra: '23:00' },\n  7: { abre: '08:00', cierra: '23:00' },\n};\n\nfunction aMinutos(hhmm) {\n  const p = String(hhmm).split(':');\n  return Number(p[0]) * 60 + Number(p[1]);\n}\nfunction rechazar(codigo, error) {\n  return [{ json: { aceptado: false, codigo: codigo, error: error } }];\n}\nfunction texto(v) {\n  return v === undefined || v === null ? '' : String(v).trim();\n}\n\nconst ahora = $now.setZone('Atlantic/Canary');\nconst tramo = HORARIO[ahora.weekday];\nconst minutos = ahora.hour * 60 + ahora.minute;\nif (!tramo || minutos < aMinutos(tramo.abre) || minutos >= aMinutos(tramo.cierra)) {\n  return rechazar(403, 'Estamos fuera del horario de atencion. No se aceptan pedidos ahora.');\n}\n\nconst body = $input.first().json.body || {};\n\n// Datos de entrega obligatorios (sustituyen al token QR de la mesa)\nconst nombre = texto(body.nombre);\nconst direccion = texto(body.direccion);\nconst telefono = texto(body.cliente_telefono);\nif (nombre.length < 2 || nombre.length > 100) return rechazar(400, 'Falta el nombre o no es valido.');\nif (direccion.length < 5 || direccion.length > 300) return rechazar(400, 'Falta la direccion o no es valida.');\nconst digitos = telefono.replace(/[^0-9]/g, '');\nif (!/^[+0-9 ()-]+$/.test(telefono) || digitos.length < 9 || digitos.length > 15) {\n  return rechazar(400, 'Falta el telefono o no es valido.');\n}\n\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  return rechazar(400, 'El pedido no contiene productos.');\n}\n\n// Solo se aceptan id y cantidad. Cualquier precio enviado por el frontend se ignora.\nconst agrupados = {};\nfor (const it of body.items) {\n  const id = it && it.id;\n  const qty = Number(it && it.qty);\n  if (id === undefined || id === null || String(id).trim() === '') {\n    return rechazar(400, 'Hay un producto sin id.');\n  }\n  if (!Number.isInteger(qty) || qty < 1 || qty > 50) {\n    return rechazar(400, 'Cantidad no valida para el producto ' + id + '.');\n  }\n  const clave = String(id);\n  agrupados[clave] = (agrupados[clave] || 0) + qty;\n}\nconst items = Object.keys(agrupados).map(function (id) { return { id: id, qty: agrupados[id] }; });\n\nreturn [{ json: { aceptado: true, nombre: nombre, direccion: direccion, cliente_telefono: telefono, items: items } }];"
      },
