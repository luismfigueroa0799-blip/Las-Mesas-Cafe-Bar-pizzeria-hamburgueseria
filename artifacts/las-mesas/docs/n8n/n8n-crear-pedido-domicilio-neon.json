    {
      "parameters": {
        "jsCode": "const nombre = String($json.customerName ?? '').trim();\nconst telefono = String($json.telefono ?? '').trim();\nconst direccion = String($json.direccion ?? '').trim();\nif (!nombre || nombre.length < 2) return [{ json: { ok: false, error: 'Nombre obligatorio' } }];\nif (!telefono || telefono.replace(/[^0-9]/g,'').length < 9) return [{ json: { ok: false, error: 'Teléfono inválido' } }];\nif (!direccion || direccion.length < 5) return [{ json: { ok: false, error: 'Dirección obligatoria' } }];\nif (!Array.isArray($json.items) || $json.items.length === 0) return [{ json: { ok: false, error: 'Carrito vacío' } }];\nconst agrupados = {};\nfor (const it of $json.items) {\n  const id = it && it.id;\n  const qty = Number(it && it.qty);\n  if (!id || String(id).trim() === '') return [{ json: { ok: false, error: 'Producto sin id' } }];\n  if (!Number.isInteger(qty) || qty < 1 || qty > 50) return [{ json: { ok: false, error: 'Cantidad inválida' } }];\n  const clave = String(id);\n  agrupados[clave] = (agrupados[clave] || 0) + qty;\n}\nreturn [{ json: { ...$json, tipo_entrega: 'domicilio', items: Object.keys(agrupados).map(id => ({ id, qty: agrupados[id] })) } }];"
      },
      "id": "c70d49dc-60fb-4a84-8772-5467715e23e2",
      "name": "Validar domicilio y carrito",
