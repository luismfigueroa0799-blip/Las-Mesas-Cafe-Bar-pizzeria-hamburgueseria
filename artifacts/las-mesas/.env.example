# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para la web oficial de Las Mesas (Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe (obligatorio para el pago) ──────────────────────────────────────────
# Panel de Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Opcional: si se define, se verifica la firma del webhook de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── URL base de la web ────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://las-mesas-cafe-bar-pizzeria-hamburgueseria-7l1h-git-main-luism4.vercel.app

# ── Supabase (opcional pero recomendado) ──────────────────────────────────────
# Permite crear el pedido en la tabla `pedidos` ANTES de abrir la pasarela de
# Stripe. El flujo de n8n lo lee para enviar el Telegram y el email con el
# detalle y el total reales.
#
# Sin esto, la web sigue funcionando: crea la sesión de Stripe y envía el
# pedido a n8n, pero n8n tendrá que crear la fila en la tabla.
#
# La clave `service_role` es NECESARIA para escribir: la tabla `pedidos` tiene
# RLS activado y la clave pública (sb_publishable_...) no puede insertar.
SUPABASE_URL=https://fohxajfpnriusuybdteu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── n8n (opcional) ────────────────────────────────────────────────────────────
# Webhook al que se reenvía el pedido una vez confirmado el pago.
# URL de producción (n8n ".../webhook/...").
N8N_WEBHOOK_URL=https://barcafeteria.app.n8n.cloud/webhook/crear-pedido-domicilio
# URL de pruebas (n8n ".../webhook-test/..."). Solo responde una llamada tras
# pulsar "Execute workflow" en n8n.
N8N_WEBHOOK_URL_TEST=https://barcafeteria.app.n8n.cloud/webhook-test/crear-pedido-domicilio
