# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para la web oficial de Las Mesas (Vercel)
#
# COPIA ESTAS VARIABLES A VERCEL tal cual, sustituyendo SOLO los valores
# marcados con <cambiar>. No dejes los <...> puestos: rompen la URL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe (obligatorio para el pago) ─────────────────────────────────────────
# Panel de Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_<PEGAR_AQUI>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<PEGAR_AQUI>
# Opcional: si se define, se verifica la firma del webhook de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── URL base de la web ────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://las-mesas-cafe-bar-pizzeria-hamburgueseria-7l1h-git-main-luism4.vercel.app

# ── Supabase (obligatorio) ───────────────────────────────────────────────────
# Misma base de datos que usa el flujo de n8n. La tabla `pedidos` guarda los
# pedidos y la tabla `productos` la carta (ids y precios que valida n8n).
#
# IMPORTANTE: la clave de servicio se llama SUPABASE_SECRET_KEY (no
# SUPABASE_SERVICE_ROLE_KEY). Con la clave publica NO se puede escribir: la
# tabla `pedidos` tiene RLS activado.
SUPABASE_URL=https://fohxajfpnriusuybdteu.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<PEGAR_AQUI>

# ── n8n (obligatorio) ────────────────────────────────────────────────────────
# Webhook que crea el pedido y devuelve la url de la pasarela de Stripe:
#   { "ok": true, "pedido_id": 26, "total": 23.95, "checkout_url": "https://..." }
#
# NO uses aquí la URL de pruebas (webhook-test): solo responde una llamada tras
# pulsar "Execute workflow" en n8n y las pruebas se quedarían sin confirmar.
N8N_WEBHOOK_URL=https://barcafeteria.app.n8n.cloud/webhook/crear-pedido-domicilio
# Solo para pruebas, y solo si el flujo de n8n está en modo escucha.
N8N_WEBHOOK_URL_TEST=https://barcafeteria.app.n8n.cloud/webhook-test/crear-pedido-domicilio

# Opcional: webhook de n8n que SOLO notifica el pedido ya pagado (Telegram,
# email o tablet). Es DISTINTO del de creacion: si se usara ese, el flujo
# insertaria un pedido duplicado.
#
# Si se deja vacio, la notificacion la hace el trigger "Pago completado en
# Stripe" de n8n, que lee los datos del metadata de la sesion y de la tabla
# `pedidos` (los rellena esta web).
N8N_WEBHOOK_NOTIFICAR=

# ----------------------------------------------------------
# Neon (base de datos de los pedidos)
# ----------------------------------------------------------
#
# Los pedidos se guardan en NEON, que es la base de datos que usan el
# flujo de n8n y la tablet. Neon es un Postgres gestionado, asi que se
# conecta con el cliente `pg` (node-postgres).
#
# Panel de Neon -> Connection Details -> "Pooled connection" (la que
# lleva -pooler en el host): es la que hay que usar en Vercel.
#
# Sin esta variable la web sigue funcionando, pero guarda los pedidos en
# Supabase (fallback) en vez de en Neon.
DATABASE_URL=postgresql://<usuario>:<password>@ep-xxx-pooler.<region>.neon.tech/<base>?sslmode=require

# ----------------------------------------------------------
# Panel de inventario (/admin/inventario)
# ----------------------------------------------------------
#
# Correos de los usuarios "staff" que pueden entrar al panel a marcar
# los productos agotados (separados por comas).
#
# Si se deja vacio, entra cualquier usuario de Supabase Auth que tenga
# user_metadata.role = "staff".
STAFF_EMAILS=admin@lasmesas.com

# Topic de ntfy.sh donde se avisa a la tablet (Telegram y email ya avisan por su cuenta).
# El mismo topic que hay que poner en el nodo HTTP Request del flujo de n8n.
NTFY_TOPIC=las-mesas-pedidos

# ----------------------------------------------------------
# Supabase Auth en el navegador (para el login del panel)
# ----------------------------------------------------------
#
# Clave PUBLICA de Supabase: Project Settings -> API Keys -> Publishable key
# (empieza por sb_publishable_...). Con ella el panel inicia sesion en el
# navegador con supabase.auth.signInWithPassword.
#
# Si no se pone, el login sigue funcionando: se hace contra /api/admin-login,
# que hace lo mismo en el servidor (y no expone la clave secreta).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<PEGAR_AQUI>
